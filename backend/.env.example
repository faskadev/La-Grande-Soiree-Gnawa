# Example environment variables for the backend
# Copy this file to `backend/.env` and fill the values (do NOT commit .env)

# Option A: single DATABASE_URL (recommended for production)
# DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<dbname>

# Option B: individual DB variables
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# App environment
NODE_ENV=development
